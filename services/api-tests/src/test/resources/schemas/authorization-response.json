{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "AuthorizationResponse (docs/api-spec.md, models section)",
  "type": "object",
  "additionalProperties": false,
  "required": ["mti", "stan", "rrn", "authCode", "responseCode", "status", "declineReason", "processingTimeMs"],
  "properties": {
    "mti": {"type": "string", "pattern": "^\\d{4}$"},
    "stan": {"type": ["string", "null"]},
    "rrn": {"type": ["string", "null"], "pattern": "^\\d{12}$"},
    "authCode": {"type": ["string", "null"], "pattern": "^[A-Z0-9]{6}$"},
    "responseCode": {"type": "string", "pattern": "^\\d{2}$"},
    "status": {"type": "string", "enum": ["APPROVED", "DECLINED"]},
    "declineReason": {"type": ["string", "null"]},
    "processingTimeMs": {"type": "integer", "minimum": 0}
  }
}
